{
  "brand": "Universe Sent Me",
  "timezone": "America/Matamoros",
  "evidence_dir": "~/.local/share/usm-metrics/evidence",
  "tiktok": {
    "account_label": "Universe Sent Me",
    "client_key_env": "USM_TIKTOK_CLIENT_KEY",
    "client_secret_env": "USM_TIKTOK_CLIENT_SECRET",
    "redirect_uri": "http://127.0.0.1:8765/callback/",
    "token_file": "~/.config/usm-metrics/tiktok-token.json",
    "required_scopes": [
      "video.list"
    ]
  },
  "youtube": {
    "channel_handle": "@Universe_Sent_Me",
    "client_secret_file": "~/.config/usm-metrics/youtube-client-secret.json",
    "token_file": "~/.config/usm-metrics/youtube-token.json",
    "scopes": [
      "https://www.googleapis.com/auth/youtube.readonly",
      "https://www.googleapis.com/auth/yt-analytics.readonly",
      "https://www.googleapis.com/auth/yt-analytics-monetary.readonly"
    ]
  }
}
