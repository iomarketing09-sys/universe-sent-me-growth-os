[Unit]
Description=Growth OS Comments Harvest (proposals only, no publish)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=20min
WorkingDirectory=/home/universe-sent-me/growth-os
ExecStart=/usr/bin/python3 /home/universe-sent-me/growth-os/scripts/run_comments_harvest.py
EnvironmentFile=-/home/universe-sent-me/growth-os/.env
User=universe-sent-me
Group=universe-sent-me
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
