[Unit]
Description=Growth OS 15-minute worker (Instagram + Ads checkpoints)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/universe-sent-me/growth-os
ExecStart=/usr/bin/python3 /home/universe-sent-me/growth-os/scripts/run_ig_scheduler.py --all-tenants
EnvironmentFile=-/home/universe-sent-me/growth-os/.env
User=universe-sent-me
Group=universe-sent-me
StandardOutput=journal
StandardError=journal
