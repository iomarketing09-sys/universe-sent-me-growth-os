[Unit]
Description=Growth OS Comments Publisher (approved replies only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=2h
WorkingDirectory=/home/universe-sent-me/growth-os
ExecStart=/usr/bin/python3 -u /home/universe-sent-me/growth-os/scripts/run_comments_publish.py --tenant universe
EnvironmentFile=-/home/universe-sent-me/growth-os/.env
User=universe-sent-me
Group=universe-sent-me
StandardOutput=journal
StandardError=journal
Nice=10

[Install]
WantedBy=multi-user.target
