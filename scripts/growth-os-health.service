[Unit]
Description=Growth OS Shared Operations Healthcheck
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=2min
WorkingDirectory=/home/universe-sent-me/growth-os
ExecStart=/usr/bin/python3 /home/universe-sent-me/growth-os/scripts/run_ops_health.py --notify --json
EnvironmentFile=-/home/universe-sent-me/growth-os/.env
User=universe-sent-me
Group=universe-sent-me
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
