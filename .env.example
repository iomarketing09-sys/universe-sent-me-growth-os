# GrowthOS Environment Configuration
# Copy to .env and fill in values
# NEVER commit .env to version control

# Core
USE_SQLITE=false
DATABASE_URL=sqlite:///data/growthos.db

# Feature flags (all false by default for safe incremental rollout)
USE_GROWTHOS_CALENDAR=false
USE_GROWTHOS_PUBLISH=false
USE_GROWTHOS_METRICS=false
USE_GROWTHOS_RECONCILE=false
USE_GROWTHOS_REELS=false
USE_GROWTHOS_COMMUNITY=false
USE_GROWTHOS_AFFILIATES=false

# Meta Graph API (Phase 3+)
# Get from Meta for Developers > Your App > Settings > Basic
META_ACCESS_TOKEN=
# App-wide: también valida X-Hub-Signature-256 en los webhooks de WhatsApp.
META_APP_SECRET=
META_PAGE_ID=1036844829507460
META_IG_USER_ID=

# Operación compartida: alertas internas por Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operación compartida: heartbeat del host al monitor externo.
# La URL la entrega el proveedor de monitoreo; es un secreto operativo.
EXTERNAL_MONITOR_HEARTBEAT_URL=

# Behavior
MOCK_META_API=true
CSV_ROUNDTRIP_STRICT=true
LOG_LEVEL=INFO
