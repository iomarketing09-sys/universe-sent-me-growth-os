# GrowthOS Environment Configuration
# Copy to .env and fill in values
# NEVER commit .env to version control

# Core
USE_SQLITE=false
DATABASE_URL=sqlite:///data/growthos.db

# Feature flags (all false by default for safe incremental rollout)
USE_GROWTHOS_CALENDAR=false
USE_GROWTHOS_PUBLISH=false
USE_GROWTHOS_METRICS=false
USE_GROWTHOS_RECONCILE=false
USE_GROWTHOS_REELS=false
USE_GROWTHOS_COMMUNITY=false
USE_GROWTHOS_AFFILIATES=false

# Meta Graph API (Phase 3+)
# Get from Meta for Developers > Your App > Settings > Basic
META_ACCESS_TOKEN=
META_APP_SECRET=
META_PAGE_ID=1036844829507460
META_IG_USER_ID=

# Behavior
MOCK_META_API=true
CSV_ROUNDTRIP_STRICT=true
LOG_LEVEL=INFO
